<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GtaJournal.Controls.MonthSummaryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="TileIconStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource TileStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TileIconStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Онлайн за месяц" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind TotalText}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource TileStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TileIconStyle}" Background="{x:Bind SuccessBrush}">
                    <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Норма выполнена" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind SuccessText}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource TileStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TileIconStyle}" Background="{x:Bind NormalBrush}">
                    <FontIcon Glyph="&#xE916;" FontSize="18" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Неполная норма" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind NormalText}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource TileStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource TileIconStyle}" Background="{x:Bind MissedBrush}">
                    <FontIcon Glyph="&#xE711;" FontSize="18" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Без онлайна" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind MissedText}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
