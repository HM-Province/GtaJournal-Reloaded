<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GtaJournal.Controls.UserColumn"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GtaJournal.ViewModels"
    xmlns:h="using:GtaJournal.Helpers">

    <UserControl.Resources>
        <DataTemplate x:Key="UserTemplate" x:DataType="vm:UserItemViewModel">
            <Grid Padding="8,7" ColumnSpacing="12" Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Скопировать упоминание" Command="{x:Bind CopyMentionCommand}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator Visibility="{x:Bind h:Bind.Visible(CanManage)}" />
                        <MenuFlyoutSubItem Text="Изменить статус" Visibility="{x:Bind h:Bind.Visible(CanManage)}">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Онлайн" Command="{x:Bind SetOnlineCommand}" />
                            <MenuFlyoutItem Text="АФК" Command="{x:Bind SetAfkCommand}" />
                            <MenuFlyoutItem Text="Оффлайн" Command="{x:Bind SetOfflineCommand}" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="Онлайн пользователя" Command="{x:Bind OpenStatsCommand}" Visibility="{x:Bind h:Bind.Visible(CanManage)}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Изменить пользователя" Command="{x:Bind EditCommand}" Visibility="{x:Bind h:Bind.Visible(CanManage)}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator Visibility="{x:Bind h:Bind.Visible(CanManage)}" />
                        <MenuFlyoutItem Text="Удалить пользователя" Command="{x:Bind DeleteCommand}" Visibility="{x:Bind h:Bind.Visible(CanManage)}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="38" Height="38" VerticalAlignment="Center">
                    <PersonPicture Width="38" Height="38" ProfilePicture="{x:Bind Avatar, Mode=OneWay}" DisplayName="{x:Bind Username}" />
                    <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="{x:Bind StatusBrush}" Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <FontIcon Glyph="&#xE735;" FontSize="11" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  Visibility="{x:Bind h:Bind.Visible(IsAdmin)}" ToolTipService.ToolTip="Администратор" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind h:Bind.Visible(HasNote)}" />
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                        Background="{x:Bind TagBrush}" Visibility="{x:Bind h:Bind.Visible(HasTag)}">
                    <TextBlock Text="{x:Bind TagText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </Grid>
        </DataTemplate>

        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Placeholders" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8" />
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок колонки -->
            <Grid Padding="16,14,14,12" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Background="{x:Bind Accent, Mode=OneWay}" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Border Grid.Column="2" CornerRadius="11" Padding="9,2" MinWidth="28" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Список -->
            <ListView Grid.Row="2" x:Name="List" ItemsSource="{x:Bind ItemsSource, Mode=OneWay}" ItemTemplate="{StaticResource UserTemplate}"
                      SelectionMode="None" Padding="4,6,4,6">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Заглушки на время первой загрузки -->
            <StackPanel Grid.Row="2" x:Name="Placeholders" Padding="14,12" Spacing="14" Visibility="{x:Bind h:Bind.Visible(IsLoading), Mode=OneWay}">
                <StackPanel.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                        <Setter Property="RadiusX" Value="4" />
                        <Setter Property="RadiusY" Value="4" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse Width="38" Height="38" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <Rectangle Grid.Column="1" Width="140" Height="12" VerticalAlignment="Center" /></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse Width="38" Height="38" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <Rectangle Grid.Column="1" Width="110" Height="12" VerticalAlignment="Center" /></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse Width="38" Height="38" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <Rectangle Grid.Column="1" Width="160" Height="12" VerticalAlignment="Center" /></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Ellipse Width="38" Height="38" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <Rectangle Grid.Column="1" Width="120" Height="12" VerticalAlignment="Center" /></Grid>
            </StackPanel>

            <!-- Пусто -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="16,32"
                        Visibility="{x:Bind h:Bind.Visible(IsEmpty), Mode=OneWay}">
                <FontIcon Glyph="{x:Bind EmptyGlyph, Mode=OneWay}" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind EmptyText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
