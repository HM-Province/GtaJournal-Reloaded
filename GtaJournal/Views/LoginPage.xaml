<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation"
    xmlns:h="using:GtaJournal.Helpers">

    <ScrollViewer>
        <Grid Padding="24" MinHeight="560">
            <Border Style="{StaticResource CardStyle}" Width="440" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Вход в журнал" Style="{StaticResource TitleTextBlockStyle}" />

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Message="{x:Bind ViewModel.InfoText, Mode=OneWay}"
                             Visibility="{x:Bind h:Bind.VisibleIfText(ViewModel.InfoText), Mode=OneWay}" />

                    <!-- Шаг 1: логин и пароль -->
                    <StackPanel Spacing="12" Visibility="{x:Bind h:Bind.Visible(ViewModel.IsCredentialsStep), Mode=OneWay}">
                        <TextBox Header="Логин" PlaceholderText="Ник в журнале"
                                 Text="{x:Bind ViewModel.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind h:Bind.Not(ViewModel.IsReLogin), Mode=OneWay}" />
                        <PasswordBox x:Name="PasswordInput" Header="Пароль" PlaceholderText="Пароль от журнала"
                                     Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnInputKeyDown" />
                    </StackPanel>

                    <!-- Шаг 2b: первичная настройка 2FA -->
                    <StackPanel Spacing="12" Visibility="{x:Bind h:Bind.Visible(ViewModel.IsSetupStep), Mode=OneWay}">
                        <TextBlock Style="{StaticResource HintTextStyle}" FontSize="13"
                                   Text="Отсканируйте QR в приложении-аутентификаторе." />
                        <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center">
                            <Image Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Width="200" Height="200" />
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Секрет" IsReadOnly="True" FontFamily="Consolas" Text="{x:Bind ViewModel.SetupSecret, Mode=OneWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" ToolTipService.ToolTip="Скопировать" Command="{x:Bind ViewModel.CopySecretCommand}">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                        <RadioButtons Header="Как входить дальше?" SelectedIndex="{x:Bind SecretChoiceIndex, Mode=TwoWay}">
                            <RadioButton Content="Подставлять коды автоматически" />
                            <RadioButton Content="Вводить код вручную" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- Код 2FA -->
                    <TextBox x:Name="CodeInput" Header="Код из приложения" PlaceholderText="000000" MaxLength="8"
                             InputScope="Number"
                             Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{x:Bind h:Bind.Visible(ViewModel.ShowCodeInput), Mode=OneWay}"
                             KeyDown="OnInputKeyDown" />

                    <!-- Шаг 2a: 2FA уже настроена — можно доверить секрет приложению -->
                    <Expander Header="Подставлять коды автоматически" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind h:Bind.Visible(ViewModel.IsTotpStep), Mode=OneWay}">
                        <TextBox PlaceholderText="Секрет из приложения-аутентификатора" FontFamily="Consolas"
                                 Text="{x:Bind ViewModel.ManualSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Expander>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Error"
                             Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                             Visibility="{x:Bind h:Bind.VisibleIfText(ViewModel.ErrorText), Mode=OneWay}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SubmitCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind h:Bind.Visible(ViewModel.IsBusy), Mode=OneWay}" Foreground="White" />
                                <TextBlock Text="{x:Bind ViewModel.SubmitText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Content="Заново" Command="{x:Bind ViewModel.RestartCommand}"
                                Visibility="{x:Bind h:Bind.Collapsed(ViewModel.IsCredentialsStep), Mode=OneWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <HyperlinkButton Content="Настройки подключения" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
                        <HyperlinkButton Content="Отмена" Command="{x:Bind ViewModel.CancelCommand}"
                                         Visibility="{x:Bind h:Bind.Visible(ViewModel.CanCancel), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</nav:RoutedPage>
