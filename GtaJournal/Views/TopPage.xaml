<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.TopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation"
    xmlns:vm="using:GtaJournal.ViewModels"
    xmlns:h="using:GtaJournal.Helpers">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Padding="24,16,24,24" Spacing="14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Топ-10 по онлайну" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="За текущий месяц" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="32" Padding="0"
                        ToolTipService.ToolTip="Обновить" AutomationProperties.Name="Обновить" Command="{x:Bind ViewModel.RefreshCommand}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind h:Bind.Collapsed(ViewModel.IsBusy), Mode=OneWay}" />
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <Grid Padding="20,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Никнейм" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Время онлайна" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Обновлено" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}" Margin="8,6,8,8">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TopRow">
                                <Grid Padding="12,10" ColumnSpacing="16" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{x:Bind PlaceBrush}" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind PlaceText}" FontWeight="SemiBold" Foreground="{x:Bind PlaceForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PersonPicture Width="30" Height="30" ProfilePicture="{x:Bind Avatar, Mode=OneWay}" DisplayName="{x:Bind Username}" />
                                        <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Background="{x:Bind TagBrush}" Visibility="{x:Bind h:Bind.Visible(HasTag)}">
                                            <TextBlock Text="{x:Bind Tag}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Time}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind LastUpdate}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,32,0,40" Visibility="{x:Bind h:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                        <FontIcon Glyph="&#xE734;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="В этом месяце ещё никого нет" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</nav:RoutedPage>
