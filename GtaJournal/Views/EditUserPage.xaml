<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.EditUserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch">
                <TextBlock Text="Изменить пользователя" Style="{StaticResource PageTitleStyle}" Margin="0" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <Border Style="{StaticResource CardStyle}" IsHitTestVisible="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <RadioButtons Header="Статус" MaxColumns="3" ItemsSource="{x:Bind ViewModel.StatusOptions}"
                                      SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}" />
                        <TextBox Header="Никнейм" PlaceholderText="{x:Bind ViewModel.NicknamePlaceholder}"
                                 Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Пароль" PlaceholderText="Оставьте пустым, чтобы не менять"
                                 Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Счёт в банке" PlaceholderText="123456"
                                 Text="{x:Bind ViewModel.Bank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox Header="Ранг" Minimum="{x:Bind ViewModel.MinRankValue}" Maximum="{x:Bind ViewModel.MaxRankValue}" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                                   Value="{x:Bind ViewModel.Rank, Mode=TwoWay}" />

                        <StackPanel>
                            <ToggleSwitch Header="Администратор" IsOn="{x:Bind ViewModel.IsAdmin, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Может управлять пользователями. Выдавайте с осторожностью!" />
                        </StackPanel>
                        <StackPanel>
                            <ToggleSwitch Header="Обновить аватар" IsOn="{x:Bind ViewModel.UpdateAvatar, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Если пользователь обновил аватар в ВК." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Сохранить изменения" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</nav:RoutedPage>
