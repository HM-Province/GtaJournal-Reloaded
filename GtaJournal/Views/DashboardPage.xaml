<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation"
    xmlns:vm="using:GtaJournal.ViewModels"
    xmlns:controls="using:GtaJournal.Controls"
    xmlns:h="using:GtaJournal.Helpers">

    <nav:RoutedPage.Resources>
        <!-- Сегмент переключателя статуса: прозрачный, в выбранном состоянии — цвет статуса -->
        <Style x:Key="StatusSegmentStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </nav:RoutedPage.Resources>

    <Grid Padding="24,16,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Профиль и статус -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="20,16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="64" Height="64" VerticalAlignment="Center">
                    <Ellipse Stroke="{x:Bind ViewModel.ProfileStatusBrush, Mode=OneWay}" StrokeThickness="3" />
                    <PersonPicture Width="54" Height="54" ProfilePicture="{x:Bind ViewModel.ProfileAvatar, Mode=OneWay}" DisplayName="{x:Bind ViewModel.ProfileName, Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{x:Bind h:Bind.VisibleIfText(ViewModel.ProfileTag), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ProfileTag, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.ProfileStatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ProfileStatusTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Сегментный переключатель статуса -->
                <Border Grid.Column="2" VerticalAlignment="Center" Padding="3" CornerRadius="9"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton Style="{StaticResource StatusSegmentStyle}" IsChecked="{x:Bind ViewModel.IsOnline, Mode=OneWay}" Command="{x:Bind ViewModel.SetOnlineCommand}">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#22A055" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#26B05E" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1E8F4C" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                            </ToggleButton.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE821;" FontSize="14" />
                                <TextBlock Text="Онлайн" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource StatusSegmentStyle}" IsChecked="{x:Bind ViewModel.IsAfk, Mode=OneWay}" Command="{x:Bind ViewModel.SetAfkCommand}">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E09A0B" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#EEA614" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C78809" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                            </ToggleButton.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE708;" FontSize="14" />
                                <TextBlock Text="АФК" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource StatusSegmentStyle}" IsChecked="{x:Bind ViewModel.IsOffline, Mode=OneWay}" Command="{x:Bind ViewModel.SetOfflineCommand}">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#DC3C3C" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#E54B4B" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C33333" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
                            </ToggleButton.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="Оффлайн" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" Width="40" Height="40" Padding="0" VerticalAlignment="Center" CornerRadius="8"
                        ToolTipService.ToolTip="Обновить" AutomationProperties.Name="Обновить" Command="{x:Bind ViewModel.RefreshCommand}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="16" Visibility="{x:Bind h:Bind.Collapsed(ViewModel.IsBusy), Mode=OneWay}" />
                        <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- Подразделения (если включены теги) -->
        <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.UnitStats}" Visibility="{x:Bind h:Bind.Visible(ViewModel.ShowUnitStats), Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="220" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:UnitStat">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Text}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <ProgressBar Value="{x:Bind Share}" Foreground="{x:Bind Brush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- Поиск и время обновления -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Поиск пользователей" QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Rectangle Width="1" Height="14" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="{x:Bind h:Bind.VisibleIfText(ViewModel.TotalText), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.LastUpdateText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Колонки пользователей -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:UserColumn Title="Онлайн" Glyph="&#xE821;" Accent="{x:Bind OnlineBrush}"
                                 CountText="{x:Bind ViewModel.OnlineCountText, Mode=OneWay}"
                                 ItemsSource="{x:Bind ViewModel.OnlineUsers}"
                                 IsLoading="{x:Bind ViewModel.IsFirstLoad, Mode=OneWay}"
                                 IsEmpty="{x:Bind ViewModel.OnlineEmpty, Mode=OneWay}"
                                 EmptyText="{x:Bind ViewModel.OnlineEmptyText, Mode=OneWay}" EmptyGlyph="{x:Bind ViewModel.OnlineEmptyGlyph, Mode=OneWay}" />

            <controls:UserColumn Grid.Column="1" Title="АФК" Glyph="&#xE708;" Accent="{x:Bind AfkBrush}"
                                 CountText="{x:Bind ViewModel.AfkCountText, Mode=OneWay}"
                                 ItemsSource="{x:Bind ViewModel.AfkUsers}"
                                 IsLoading="{x:Bind ViewModel.IsFirstLoad, Mode=OneWay}"
                                 IsEmpty="{x:Bind ViewModel.AfkEmpty, Mode=OneWay}"
                                 EmptyText="{x:Bind ViewModel.AfkEmptyText, Mode=OneWay}" EmptyGlyph="{x:Bind ViewModel.AfkEmptyGlyph, Mode=OneWay}" />

            <controls:UserColumn Grid.Column="2" Title="Оффлайн" Glyph="&#xE711;" Accent="{x:Bind OfflineBrush}"
                                 CountText="{x:Bind ViewModel.OfflineCountText, Mode=OneWay}"
                                 ItemsSource="{x:Bind ViewModel.OfflineUsers}"
                                 IsLoading="{x:Bind ViewModel.IsFirstLoad, Mode=OneWay}"
                                 IsEmpty="{x:Bind ViewModel.OfflineEmpty, Mode=OneWay}"
                                 EmptyText="{x:Bind ViewModel.OfflineEmptyText, Mode=OneWay}" EmptyGlyph="{x:Bind ViewModel.OfflineEmptyGlyph, Mode=OneWay}" />
        </Grid>
    </Grid>
</nav:RoutedPage>
