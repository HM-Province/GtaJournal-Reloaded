<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation"
    xmlns:vm="using:GtaJournal.ViewModels"
    xmlns:h="using:GtaJournal.Helpers">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12" MaxWidth="820" HorizontalAlignment="Stretch">
                <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}" Margin="0" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Оформление" Style="{StaticResource SectionTitleStyle}" />
                        <RadioButtons Header="Тема" MaxColumns="3" ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                      SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Наблюдение за игрой" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <StackPanel>
                            <AutoSuggestBox Header="Процесс" PlaceholderText="Multi Theft Auto.exe"
                                            Text="{x:Bind ViewModel.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{x:Bind ViewModel.ProcessSuggestions}"
                                            TextChanged="OnProcessTextChanged"
                                            GotFocus="OnProcessFocus" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <NumberBox Header="Частота опроса, секунд" Width="220" HorizontalAlignment="Left"
                                       Minimum="{x:Bind ViewModel.MinPoll}" Maximum="{x:Bind ViewModel.MaxPoll}"
                                       SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.PollInterval, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Сайт журнала" Style="{StaticResource SectionTitleStyle}" />
                        <TextBox Header="Основной URL" PlaceholderText="https://status-journal.com"
                                 Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Звук и уведомления" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch Header="Звук при клике" IsOn="{x:Bind ViewModel.ClickSound, Mode=TwoWay}" />
                        <ToggleSwitch Header="Звук оповещения" IsOn="{x:Bind ViewModel.AlertSound, Mode=TwoWay}" />
                        <ToggleSwitch Header="Уведомления Windows" IsOn="{x:Bind ViewModel.Notifications, Mode=TwoWay}" />
                        <ToggleSwitch Header="Сворачивать в трей при закрытии" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Теги подразделений" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <ToggleSwitch Header="Использовать теги в никах ([ОКБ-М] Nick_Name)" IsOn="{x:Bind ViewModel.UseTags, Mode=TwoWay}" />

                        <StackPanel Spacing="8" Visibility="{x:Bind h:Bind.Visible(ViewModel.UseTags), Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UnitTagEditor">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="14" Height="14" Fill="{x:Bind Preview, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" PlaceholderText="Тег в нике, напр. ОКБ-М" Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2" PlaceholderText="Подпись" Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="3" PlaceholderText="#RRGGBB" FontFamily="Consolas" Text="{x:Bind Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="4" ToolTipService.ToolTip="Удалить" Click="OnRemoveTagClick" Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{x:Bind ViewModel.AddTagCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Добавить тег" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Сохранить изменения" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="О приложении" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <TextBlock Text="{x:Bind ViewModel.AppVersion}" Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.CheckUpdatesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="Проверить обновления" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</nav:RoutedPage>
