<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.AddUserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch">
                <TextBlock Text="Добавить пользователя" Style="{StaticResource PageTitleStyle}" Margin="0" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBox Header="Никнейм" PlaceholderText="{x:Bind ViewModel.NicknamePlaceholder}"
                                 Text="{x:Bind ViewModel.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Пароль" PlaceholderText="Оставьте пустым для случайного"
                                 Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Счёт в банке" PlaceholderText="123456"
                                 Text="{x:Bind ViewModel.Bank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Ссылка на ВК" PlaceholderText="https://vk.com/id1"
                                 Text="{x:Bind ViewModel.VkLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <NumberBox Header="Ранг" Minimum="{x:Bind ViewModel.MinRankValue}" Maximum="{x:Bind ViewModel.MaxRankValue}" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                                   Value="{x:Bind ViewModel.Rank, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="Логин и пароль нового пользователя будут скопированы в буфер обмена." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                                    <TextBlock Text="Добавить пользователя" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.AddAndContinueCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Добавить и создать ещё" />
                                </StackPanel>
                            </Button>
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</nav:RoutedPage>
