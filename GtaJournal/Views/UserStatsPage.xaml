<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.UserStatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation"
    xmlns:controls="using:GtaJournal.Controls"
    xmlns:h="using:GtaJournal.Helpers">

    <nav:RoutedPage.Resources>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </nav:RoutedPage.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Padding="24,16,24,24" Spacing="14">
            <!-- Заголовок и фильтры -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Онлайн пользователей" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="240" VerticalAlignment="Center" PlaceholderText="Выберите пользователя"
                          ItemsSource="{x:Bind ViewModel.Users}"
                          SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" Width="180" VerticalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.Months}"
                          SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}" />
                <Button Grid.Column="3" Width="36" Height="32" Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Обновить" AutomationProperties.Name="Обновить" Command="{x:Bind ViewModel.RefreshCommand}">
                    <Grid>
                        <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind h:Bind.Collapsed(ViewModel.IsBusy), Mode=OneWay}" />
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Пользователь не выбран -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24,56"
                    Visibility="{x:Bind h:Bind.Visible(ViewModel.ShowPlaceholder), Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE716;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Выберите пользователя" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Здесь появится его онлайн за месяц" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Сведения о пользователе -->
            <StackPanel Spacing="14" Visibility="{x:Bind h:Bind.Visible(ViewModel.HasUser), Mode=OneWay}">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture Width="52" Height="52" DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.UserName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                            <StackPanel Orientation="Horizontal" Spacing="28">
                                <StackPanel>
                                    <TextBlock Text="Счёт в банке" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.Bank, Mode=OneWay}" Style="{StaticResource InfoValueStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Первая половина месяца" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.FirstHalf, Mode=OneWay}" Style="{StaticResource InfoValueStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Вторая половина месяца" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SecondHalf, Mode=OneWay}" Style="{StaticResource InfoValueStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.EditUserCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Изменить" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <controls:MonthSummaryPanel Summary="{x:Bind ViewModel.Summary, Mode=OneWay}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.MonthTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,0,0" />
                        <controls:OnlineCalendar Calendar="{x:Bind ViewModel.Calendar, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</nav:RoutedPage>
