<?xml version="1.0" encoding="utf-8"?>
<nav:RoutedPage
    x:Class="GtaJournal.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:GtaJournal.Core.Navigation"
    xmlns:vm="using:GtaJournal.ViewModels"
    xmlns:h="using:GtaJournal.Helpers">

    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        IsSettingsVisible="False"
        IsBackButtonVisible="Auto"
        IsBackEnabled="False"
        AlwaysShowHeader="False"
        OpenPaneLength="260"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="OnItemInvoked"
        BackRequested="OnBackRequested">

        <NavigationView.PaneFooter>
            <!-- Поля 4+4: в свёрнутом меню (48 px) аватар 32 px помещается целиком и стоит по центру, как иконки пунктов -->
            <Button
                x:Name="AccountButton"
                Margin="4,0,4,8"
                Padding="4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Аккаунт"
                AutomationProperties.Name="Аккаунт">
                <Button.Flyout>
                    <Flyout x:Name="AccountFlyout" Placement="TopEdgeAlignedLeft" Opening="OnAccountFlyoutOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="MinWidth" Value="300" />
                                <Setter Property="MaxWidth" Value="380" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>

                        <StackPanel Spacing="2">
                            <StackPanel.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="ms-appx:///Styles/SubtleButton.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                    <Style x:Key="AccountMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,7" />
                                    </Style>
                                </ResourceDictionary>
                            </StackPanel.Resources>

                            <TextBlock Text="Аккаунты" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="10,6,10,4" Visibility="{x:Bind h:Bind.Visible(ViewModel.HasAccounts), Mode=OneWay}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.MenuAccounts}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountMenuItem">
                                        <Button Style="{StaticResource AccountMenuButtonStyle}" Tag="{x:Bind}" Click="OnAccountItemClick"
                                                AutomationProperties.Name="{x:Bind Title}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <PersonPicture Width="36" Height="36" ProfilePicture="{x:Bind Avatar, Mode=OneWay}" DisplayName="{x:Bind Title}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Login}" Style="{StaticResource HintTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               Visibility="{x:Bind h:Bind.Visible(ShowLogin)}" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          Visibility="{x:Bind h:Bind.Visible(IsActive)}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Rectangle Height="1" Margin="-4,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       Visibility="{x:Bind h:Bind.Visible(ViewModel.HasAccounts), Mode=OneWay}" />

                            <Button Style="{StaticResource AccountMenuButtonStyle}" Command="{x:Bind ViewModel.AddAccountCommand}" Click="OnAccountMenuActionClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8FA;" FontSize="16" />
                                    <TextBlock Text="Добавить аккаунт" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccountMenuButtonStyle}" Command="{x:Bind ViewModel.ManageAccountsCommand}" Click="OnAccountMenuActionClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE716;" FontSize="16" />
                                    <TextBlock Text="Управление аккаунтами" />
                                </StackPanel>
                            </Button>

                            <StackPanel Spacing="2" Visibility="{x:Bind h:Bind.Visible(ViewModel.HasActiveAccount), Mode=OneWay}">
                                <Rectangle Height="1" Margin="-4,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button Style="{StaticResource AccountMenuButtonStyle}" Command="{x:Bind ViewModel.LogoutCommand}" Click="OnAccountMenuActionClick">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                                        <TextBlock Text="Выйти из аккаунта" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32">
                        <PersonPicture Width="32" Height="32" ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay}" DisplayName="{x:Bind ViewModel.AccountTitle, Mode=OneWay}" />
                        <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{x:Bind ViewModel.StatusBrush, Mode=OneWay}"
                                 Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                Visibility="{x:Bind h:Bind.Visible(NavView.IsPaneOpen), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.AccountTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.AccountSubtitle, Mode=OneWay}" Style="{StaticResource HintTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Margin="0,0,4,0" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center"
                              Visibility="{x:Bind h:Bind.Visible(NavView.IsPaneOpen), Mode=OneWay}" />
                </Grid>
            </Button>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</nav:RoutedPage>
